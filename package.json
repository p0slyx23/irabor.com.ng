{
  "name": "irabor",
  "private": true,
  "version": "2.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "api:dev": "node --watch --env-file-if-exists=server/.env server/index.mjs",
    "api:build": "node server/build.mjs",
    "api:start": "node --env-file-if-exists=server/.env server/index.mjs",
    "db:check": "node --env-file-if-exists=server/.env server/check.mjs",
    "db:migrate": "node --env-file-if-exists=server/.env server/migrate.mjs",
    "db:export-seed": "node --env-file-if-exists=server/.env scripts/export-content-seed.mjs",
    "assets:check": "node --env-file-if-exists=server/.env server/assets.mjs --check",
    "assets:sync": "node --env-file-if-exists=server/.env server/assets.mjs",
    "test:server": "node --test server/tests/*.test.mjs",
    "optimize:project-covers": "node scripts/optimize-project-covers.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1172.0",
    "framer-motion": "^12.38.0",
    "mysql2": "^3.24.6",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "sharp": "^0.35.5",
    "vite": "^7.3.1"
  }
}
