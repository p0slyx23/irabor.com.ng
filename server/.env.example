# Copy to server/.env. Never add database credentials to a VITE_* variable.
# Local access to Railway requires its MYSQL_PUBLIC_URL value here.
# On Railway, reference the MySQL service's private MYSQL_URL instead.
MYSQL_URL=mysql://username:password@hostname:3306/railway

# The API service receives PORT automatically when deployed to Railway.
PORT=3001
HOST=0.0.0.0
CORS_ORIGINS=http://localhost:5173,http://localhost:4173,https://irabor.com.ng

# Enable only if the database endpoint supports TLS. Verification stays enabled.
MYSQL_SSL=false
# Optional path to a trusted PEM CA file, relative to the repository root.
MYSQL_SSL_CA_FILE=
