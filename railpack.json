{
  "$schema": "https://schema.railpack.com",
  "provider": "node",
  "steps": {
    "install": {
      "commands": [
        { "src": "package.json", "dest": "package.json" },
        { "src": "package-lock.json", "dest": "package-lock.json" },
        "npm ci --omit=dev"
      ]
    },
    "build": {
      "commands": ["npm run api:build"]
    }
  },
  "deploy": {
    "startCommand": "npm run api:start"
  }
}
